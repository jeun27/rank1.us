{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/run-jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 13,14 * * 1"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "0 14,15 1 * *"
    }
  ]
}
