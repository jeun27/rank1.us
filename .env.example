# Every environment variable Rank1 reads (docs/INTEGRATIONS.md). Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_ names reach the browser; every other name is server-only.

DATAFORSEO_LOGIN= # DataForSEO API login (basic auth), server-only
DATAFORSEO_PASSWORD= # DataForSEO API password (basic auth), server-only
PERPLEXITY_API_KEY= # Perplexity Agent API key, server-only
DATAFORSEO_API_URL= # Optional; default https://api.dataforseo.com/v3. e2e only: loopback hosts only, ignored on Vercel production
PERPLEXITY_API_URL= # Optional; default https://api.perplexity.ai/v1/agent. e2e only: loopback hosts only, ignored on Vercel production
PERPLEXITY_MODEL= # Optional Perplexity Agent API model id; default perplexity/sonar (models.md), server-only
NEXT_PUBLIC_SUPABASE_URL= # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY= # Supabase anon key (safe in the browser; RLS protects data)
SUPABASE_SERVICE_ROLE_KEY= # Supabase service-role key, server-only, bypasses RLS
STRIPE_SECRET_KEY= # Stripe secret key, TEST mode only (sk_test_...), server-only
STRIPE_WEBHOOK_SECRET= # Stripe webhook signing secret, server-only
STRIPE_PRICE_ID_BUSINESS= # Stripe recurring Price id for $99/month per business
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # UNUSED: hosted Checkout redirects server-side, so no publishable key (Step 14)
GOOGLE_CLIENT_ID= # Google OAuth client id (Connections: GBP, Search Console, GA4)
GOOGLE_CLIENT_SECRET= # Google OAuth client secret, server-only
GOOGLE_TOKEN_ENCRYPTION_KEY= # 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored Google tokens (AES-256-GCM), server-only
RESEND_API_KEY= # Resend API key, server-only
REPORT_FROM_EMAIL= # Sender address for monthly reports
CONTACT_TO_EMAIL= # Where Contact us messages go
CONTACT_FROM_EMAIL= # Sender address for Contact us notifications
NEXT_PUBLIC_TURNSTILE_SITE_KEY= # Cloudflare Turnstile site key
TURNSTILE_SECRET_KEY= # Cloudflare Turnstile secret, server-only
IP_HASH_SALT= # Random string mixed into SHA-256 IP hashes for form rate limits, server-only
CRON_SECRET= # Bearer token Vercel Cron sends to cron routes, server-only
RUN_JOBS_BATCH= # Optional: max jobs the run-jobs cron claims per invocation (default 20)
FOUNDER_EMAIL= # Email allowed into the founder Admin screen
AUDIT_DAILY_LIMIT= # Max free audits per day
SHOW_SOCIAL_PROOF=false # Keep false until real logos and a real testimonial exist
NEXT_PUBLIC_SITE_URL= # Public base URL, e.g. https://rank1.us
E2E_BASE_URL= # Optional: run Playwright against a deployed URL (e.g. the Vercel preview) instead of a local build
VERCEL_AUTOMATION_BYPASS_SECRET= # Optional: Vercel Protection Bypass for Automation secret, sent as x-vercel-protection-bypass so Playwright can reach protected previews
ENABLE_TEAM_WORKSPACE=false # true shows the /team team workspace (Example data). Keep false in production until Jeun says so; true on preview
ENABLE_CONNECTIONS=false # true turns on every Connections surface and route (404 otherwise). true on preview only until QA
ENABLE_AI_ACCESS_CHECK=false # true runs G2 "Can AI see your site?" with free audits and the weekly fix pass (R16). true on preview only until QA
ENABLE_NARRATIVE=false # true turns on G4 "How AI describes you" (a word match on stored answers). true on preview only until QA
ENABLE_MENTIONS=false # true turns on G7 "Lists that name your rivals but not you" and its grouped R17 fix. true on preview only until QA
